# Port the HTTP server listens on
PORT=8080
# The domain names live under: alice*flexipay.app
HOME_DOMAIN=flexipay.app
# Public URL where this service is reachable (used in stellar.toml)
PUBLIC_URL=https://api.flexipay.app
# testnet | mainnet
STELLAR_NETWORK=testnet
# Where registrations are stored (JSON file)
DATA_FILE=./data/names.json
# Comma-separated list of allowed browser origins ("*" for any)
CORS_ORIGINS=*
